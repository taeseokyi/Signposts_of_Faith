# content.md 와 template/ 에서 다시 만들 수 있는 빌드 결과
*/board.html
*/board_preview.html
*/게시정보.txt
*.pdf

# 노트 사진 (원본 이미지는 크고 매일 쌓여 저장소에 넣지 않는다)
*/노트/

# 파이썬
__pycache__/
*.pyc

# 웹사이트 빌드 결과 (GitHub Actions가 만든다)
_site/

# 로컬 도구 설정
.claude/

# Claude와 나눈 대화 원문 (공개 저장소에 올리지 않는다)
*/대화.md

# 도우미 백엔드(server/)가 만드는 것: 초안·작업 상태·미리보기 빌드, 자체 서명 인증서(개인 키), 로그
server/data/
server/certs/
server.log
server.pid
# 접근 토큰과 명령 경로
.env.local
node_modules/
